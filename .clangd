CompileFlags:
  CompilationDatabase: build/Debug
  Remove:
    - -mcpu=*
    - -mfpu=*
    - -mfloat-abi=*
    - -mthumb*
  Add:
    - --sysroot=/home/elio/.local/share/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/arm-none-eabi
    - --target=arm-none-eabi
    - -DSTM32H723xx
    - -DUSE_HAL_DRIVER
    - -DUSE_PWR_LDO_SUPPLY
